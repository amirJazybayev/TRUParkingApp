<?xml version="1.0" encoding="utf-8"?>
<!-- First screen after logging in: every active lot with its free spot count. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lots_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pme_background"
    android:orientation="vertical"
    tools:context=".ParkingLotsActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_lots"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/pme_background"
        app:title="@string/brand_name"
        app:titleTextColor="@color/pme_navy" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lots_heading"
            android:textAppearance="@style/TextAppearance.TRUParking.Title" />

        <TextView
            android:id="@+id/text_lots_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/lots_loading"
            android:textAppearance="@style/TextAppearance.TRUParking.Subtitle"
            tools:text="3 lots · 42 free spots right now" />

        <TextView
            android:id="@+id/text_guest_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/lots_guest_note"
            android:textAppearance="@style/TextAppearance.TRUParking.Small"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/text_lots_error"
            style="@style/Widget.TRUParking.Banner"
            android:layout_marginTop="@dimen/field_spacing"
            android:visibility="gone"
            tools:text="@string/error_no_internet"
            tools:visibility="visible" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_lots"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/section_spacing"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/screen_padding"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_lot" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_lots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@color/pme_green" />

        <TextView
            android:id="@+id/text_lots_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="@dimen/screen_padding"
            android:gravity="center"
            android:text="@string/lots_empty"
            android:textAppearance="@style/TextAppearance.TRUParking.Body"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
