<?xml version="1.0" encoding="utf-8"?>
<!-- One parking lot in the list on the lots screen. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.TRUParking.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/field_spacing"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Name on the left, code badge on the right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_lot_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.TRUParking.Heading"
                tools:text="Lot C" />

            <TextView
                android:id="@+id/text_lot_code"
                style="@style/Widget.TRUParking.LotBadge"
                tools:text="C" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_lot_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/small_spacing"
            android:textAppearance="@style/TextAppearance.TRUParking.Body"
            tools:text="Behind the Old Main building, closest to the library." />

        <!-- Free / total count -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/field_spacing"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_lot_free"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/spot_available"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                tools:text="12" />

            <TextView
                android:id="@+id/text_lot_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textAppearance="@style/TextAppearance.TRUParking.Body"
                tools:text="free of 40 spots" />
        </LinearLayout>

        <!-- How full the lot is -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_lot_occupancy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/small_spacing"
            android:importantForAccessibility="no"
            android:max="100"
            app:indicatorColor="@color/spot_occupied"
            app:trackColor="@color/pme_green_light"
            app:trackCornerRadius="4dp"
            app:trackThickness="8dp"
            tools:progress="70" />

        <!-- Open the spot grid / map hand-off (map is a placeholder for now) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/field_spacing"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_view_spots"
                style="@style/Widget.TRUParking.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/small_spacing"
                android:layout_weight="1"
                android:text="@string/action_view_spots" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_show_on_map"
                style="@style/Widget.TRUParking.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_show_on_map" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
